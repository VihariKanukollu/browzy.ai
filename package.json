    "glob": "^11.0.1",
    "gray-matter": "^4.0.3",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "mime-types": "^2.1.35",
    "openai": "^4.77.0",
